# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio.
APP_URL="MY_APP_URL"

# TIKTOK_CLIENT_KEY: Client Key from the TikTok Developer Portal (Login Kit / TikTok Display API).
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"

# TIKTOK_CLIENT_SECRET: Client Secret from the TikTok Developer Portal (kept strictly server-side, never exposed to client).
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"

# SUPABASE (Client-side public config)
VITE_SUPABASE_URL="https://cszycxjiurmwdtkuzaql.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

