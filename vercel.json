{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/tiktok(.*)\\.txt",
      "destination": "/api/index?__path=/tiktok$1.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
